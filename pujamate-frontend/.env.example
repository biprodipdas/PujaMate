# src/app connects to the Phase 1 Express API
NEXT_PUBLIC_API_URL=http://localhost:4000

# Maps SDK — required for MapView (src/components/map/MapView.jsx) to render
# tiles. Get a public token from https://account.mapbox.com/access-tokens/
NEXT_PUBLIC_MAPBOX_TOKEN=your_mapbox_public_token

NEXT_PUBLIC_VAPID_PUBLIC_KEY=""

# Community photo wall — direct browser upload to Cloudinary (unsigned preset)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your_unsigned_upload_preset
