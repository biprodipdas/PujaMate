# ============================================================
# PujaMate Backend — Environment Variables
# Copy this file to .env and fill in real values. Never commit .env.
# ============================================================

# Server
PORT=4000
NODE_ENV=development

# Neon PostgreSQL — copy the pooled connection string from your Neon dashboard
# Example: postgres://user:password@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/pujamate?sslmode=require
DATABASE_URL=postgres://user:password@your-neon-host/pujamate?sslmode=require
# Set to "false" only for local/self-hosted Postgres without SSL configured
# (e.g. local development). Leave unset (defaults to true) for Neon.
PGSSL=true

# JWT Authentication
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:3000

# Puja Passport — max distance (meters) between a user's submitted GPS
# coordinates and a pandal's registered location to allow check-in
GEOFENCE_RADIUS_METERS=200

# Maps SDK (used later by the Next.js frontend, kept here for reference)
NEXT_PUBLIC_MAPBOX_TOKEN=your_mapbox_public_token

# Web Push (V2)
VAPID_SUBJECT="mailto:you@example.com"
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
